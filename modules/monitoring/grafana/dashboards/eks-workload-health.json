        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_waiting_reason{namespace=~\"$namespace\",reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError|RunContainerError\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Blocked Containers",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
