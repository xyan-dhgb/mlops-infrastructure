      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_unschedulable{namespace=~\"$namespace\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Unschedulable Pods",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
