          "legendFormat": "StatefulSets",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_daemonset_status_number_ready{namespace=~\"$namespace\"}) / clamp_min(sum(kube_daemonset_status_desired_number_scheduled{namespace=~\"$namespace\"}), 1)",
          "legendFormat": "DaemonSets",
          "refId": "C"
