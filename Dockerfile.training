# ── Dockerfile.training ──────────────────────────────────────────────────────
# Multi-stage build for ML training workloads
# Usage: docker build -f Dockerfile.training -t mlops-training .
# ─────────────────────────────────────────────────────────────────────────────

ARG PYTHON_VERSION=3.11
ARG BUILD_SHA=unknown

# ── Stage 1: dependency builder ───────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /build

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ git curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --prefix=/install --no-cache-dir -r requirements.txt

# ── Stage 2: runtime image ────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS runtime

ARG BUILD_SHA
ENV BUILD_SHA=${BUILD_SHA} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy source
COPY src/ ./src/

# Non-root user for security
RUN useradd --no-create-home --shell /bin/false mluser \
    && chown -R mluser:mluser /app
USER mluser

LABEL org.opencontainers.image.revision=${BUILD_SHA} \
      org.opencontainers.image.title="mlops-training"

# Default: run training entry point
ENTRYPOINT ["python", "-m", "src.train"]
